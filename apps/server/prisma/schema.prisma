// Schema v3 (MongoDB Atlas) — mirrors wiki/plan.md "Schema v3".
// Schema steward: Ojas. Only the steward edits this file.
// No migrations on MongoDB: `pnpm --filter @web/server db:push` syncs indexes.
// IDs are string UUIDs stored in _id (contract Id = uuid). DateTime is a UTC
// BSON Date: compare instants, never day_of_week.
// Rules Postgres used to enforce that code must now enforce (see wiki/invariants.md):
//   - friendships: userLowId < userHighId (sort the pair before writing)
//   - one open (voting|confirmed) event per groupKey: matcher mutex + check

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum VibeTag {
  quick_coffee
  casual_hangout
  dinner
  night_out
}

enum EventStatus {
  voting
  confirmed
  chatted
  expired
  completed
}

enum VoteStatus {
  invited
  voted
  ghost_passed
  confirmed
}

enum VenueStatus {
  open
  reported_closed
}

enum BusySource {
  device_calendar
  google_calendar
  seed
}

enum GoogleCalendarConnectionStatus {
  active
  revoked
  error
}

model User {
  id           String   @id @default(uuid()) @map("_id")
  username     String   @unique
  email        String   @unique
  passwordHash String   @map("password_hash")
  timezone     String // IANA, e.g. America/New_York
  homeLat      Float?   @map("home_lat") // rounded to 3 dp (~110 m)
  homeLng      Float?   @map("home_lng")
  travelMode   String   @default("DRIVE") @map("travel_mode")
  createdAt    DateTime @default(now()) @map("created_at")

  busyBlocks               BusyBlock[]
  friendshipsLow           Friendship[]              @relation("FriendshipLow")
  friendshipsHigh          Friendship[]              @relation("FriendshipHigh")
  groupsCreated            ExplicitGroup[]
  groupMembers             GroupMember[]
  favorites                UserFavorite[]
  eventsCreated            Event[]                   @relation("UserCreatedEvents")
  participations           EventParticipant[]
  votes                    Vote[]
  expensesPaid             Expense[]
  expenseSplits            ExpenseSplit[]
  googleCalendarConnection GoogleCalendarConnection?

  @@map("users")
}

model GoogleCalendarConnection {
  id              String                         @id @default(uuid()) @map("_id")
  userId          String                         @unique @map("user_id")
  refreshTokenEnc String                         @map("refresh_token_enc") // AES-256-GCM ciphertext only; encrypted by the OAuth handler.
  scopes          String[]
  status          GoogleCalendarConnectionStatus @default(active)
  connectedAt     DateTime                       @default(now()) @map("connected_at")
  lastSyncedAt    DateTime?                      @map("last_synced_at")
  lastError       String?                        @map("last_error")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("google_calendar_connections")
}

model BusyBlock {
  id       String     @id @default(uuid()) @map("_id")
  userId   String     @map("user_id")
  startsAt DateTime   @map("starts_at")
  endsAt   DateTime   @map("ends_at")
  source   BusySource
  syncedAt DateTime   @default(now()) @map("synced_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startsAt])
  @@map("busy_blocks")
}

/// Exactly one document per pair; code must sort so userLowId < userHighId.
/// mutual = lowAddedHigh AND highAddedLow — compute in queries.
model Friendship {
  id               String    @id @default(uuid()) @map("_id")
  userLowId        String    @map("user_low_id")
  userHighId       String    @map("user_high_id")
  lowAddedHigh     Boolean   @default(false) @map("low_added_high")
  highAddedLow     Boolean   @default(false) @map("high_added_low")
  interactionScore Float     @default(0.5) @map("interaction_score")
  lastHangoutAt    DateTime? @map("last_hangout_at")

  userLow  User @relation("FriendshipLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh User @relation("FriendshipHigh", fields: [userHighId], references: [id], onDelete: Cascade)

  @@unique([userLowId, userHighId])
  @@index([userHighId]) // "my friendships" looks up both sides
  @@map("friendships")
}

model ExplicitGroup {
  id        String @id @default(uuid()) @map("_id")
  name      String
  createdBy String @map("created_by")

  creator User          @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  members GroupMember[]
  events  Event[]

  @@map("explicit_groups")
}

model GroupMember {
  id      String @id @default(uuid()) @map("_id")
  groupId String @map("group_id")
  userId  String @map("user_id")
  role    String @default("member")

  group ExplicitGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("group_members")
}

model UserFavorite {
  id            String  @id @default(uuid()) @map("_id")
  userId        String  @map("user_id")
  category      String
  venueName     String? @map("venue_name")
  googlePlaceId String? @map("google_place_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_favorites")
}

model Event {
  id            String      @id @default(uuid()) @map("_id")
  groupKey      String      @map("group_key") // sorted member ids joined
  sourceGroupId String?     @map("source_group_id")
  createdById   String?     @map("created_by_id")
  status        EventStatus @default(voting)
  startsAt      DateTime    @map("starts_at")
  endsAt        DateTime    @map("ends_at")
  vibeTag       VibeTag     @map("vibe_tag")
  timezone      String
  venuePlaceId  String?     @map("venue_place_id")
  venueName     String?     @map("venue_name")
  venueLat      Float?      @map("venue_lat")
  venueLng      Float?      @map("venue_lng")
  venueStatus   VenueStatus @default(open) @map("venue_status")
  venueSnapshot Json?       @map("venue_snapshot") // EventOption of the current venue; survives backup swaps
  backupVenues  Json        @default("[]") @map("backup_venues") // EventOption[] snapshots
  voteClosesAt  DateTime    @map("vote_closes_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  resolvedAt    DateTime?   @map("resolved_at")
  matchReason   String?     @map("match_reason") // Null for the deterministic fallback.

  sourceGroup  ExplicitGroup?     @relation(fields: [sourceGroupId], references: [id], onDelete: SetNull)
  creator      User?              @relation(name: "UserCreatedEvents", fields: [createdById], references: [id], onDelete: SetNull)
  participants EventParticipant[]
  options      EventOption[]
  votes        Vote[]
  expenses     Expense[]

  @@index([groupKey, status])
  @@index([status, voteClosesAt])
  @@map("events")
}

model EventParticipant {
  id         String     @id @default(uuid()) @map("_id")
  eventId    String     @map("event_id")
  userId     String     @map("user_id")
  voteStatus VoteStatus @default(invited) @map("vote_status")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_participants")
}

model EventOption {
  id              String  @id @default(uuid()) @map("_id")
  eventId         String  @map("event_id")
  rank            Int
  placeId         String  @map("place_id")
  name            String
  lat             Float
  lng             Float
  primaryType     String? @map("primary_type")
  priceLevel      Int?    @map("price_level")
  rating          Float?
  userRatingCount Int?    @map("user_rating_count")
  travelMinutes   Json    @map("travel_minutes") // { "<user_id>": 12, ... }
  maxTravelMin    Int     @map("max_travel_min")
  routeScore      Float   @map("route_score")
  factsLine       String  @map("facts_line")
  aiBlurb         String? @map("ai_blurb")

  event Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  votes Vote[]

  @@unique([eventId, rank])
  @@map("event_options")
}

/// Never exposed per-user via API or socket. One vote per (event, user).
model Vote {
  id       String   @id @default(uuid()) @map("_id")
  eventId  String   @map("event_id")
  userId   String   @map("user_id")
  optionId String   @map("option_id")
  castAt   DateTime @default(now()) @map("cast_at")

  event  Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  option EventOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("votes")
}

// ---------- stretch ----------
model Expense {
  id          String   @id @default(uuid()) @map("_id")
  eventId     String   @map("event_id")
  paidBy      String   @map("paid_by")
  totalCents  Int      @map("total_cents")
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  event  Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  payer  User           @relation(fields: [paidBy], references: [id], onDelete: Cascade)
  splits ExpenseSplit[]

  @@map("expenses")
}

model ExpenseSplit {
  id              String  @id @default(uuid()) @map("_id")
  expenseId       String  @map("expense_id")
  userId          String  @map("user_id")
  amountOwedCents Int     @map("amount_owed_cents")
  settled         Boolean @default(false)

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("expense_splits")
}
