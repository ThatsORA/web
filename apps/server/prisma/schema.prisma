// Schema v2 — mirrors wiki/plan.md "Schema v2". Schema steward: Ojas.
// Only the steward edits this file or creates migrations.
// All timestamps are timestamptz; compare instants, never day_of_week.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VibeTag {
  quick_coffee
  casual_hangout
  dinner
  night_out
}

enum EventStatus {
  voting
  confirmed
  chatted
  expired
  completed
}

enum VoteStatus {
  invited
  voted
  ghost_passed
  confirmed
}

enum VenueStatus {
  open
  reported_closed
}

enum BusySource {
  device_calendar
  seed
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique
  email        String   @unique
  passwordHash String   @map("password_hash")
  timezone     String // IANA, e.g. America/New_York
  homeLat      Decimal? @map("home_lat") @db.Decimal(8, 3) // rounded, ~110 m
  homeLng      Decimal? @map("home_lng") @db.Decimal(8, 3)
  travelMode   String   @default("DRIVE") @map("travel_mode")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  busyBlocks      BusyBlock[]
  friendshipsLow  Friendship[]       @relation("FriendshipLow")
  friendshipsHigh Friendship[]       @relation("FriendshipHigh")
  groupsCreated   ExplicitGroup[]
  groupMembers    GroupMember[]
  favorites       UserFavorite[]
  participations  EventParticipant[]
  votes           Vote[]
  expensesPaid    Expense[]
  expenseSplits   ExpenseSplit[]

  @@map("users")
}

model BusyBlock {
  id       String     @id @default(uuid()) @db.Uuid
  userId   String     @map("user_id") @db.Uuid
  startsAt DateTime   @map("starts_at") @db.Timestamptz(6)
  endsAt   DateTime   @map("ends_at") @db.Timestamptz(6)
  source   BusySource
  syncedAt DateTime   @default(now()) @map("synced_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startsAt])
  @@map("busy_blocks")
}

/// Exactly one row per pair; user_low_id < user_high_id (CHECK in migration SQL).
/// mutual = lowAddedHigh AND highAddedLow — compute in queries.
model Friendship {
  id               String    @id @default(uuid()) @db.Uuid
  userLowId        String    @map("user_low_id") @db.Uuid
  userHighId       String    @map("user_high_id") @db.Uuid
  lowAddedHigh     Boolean   @default(false) @map("low_added_high")
  highAddedLow     Boolean   @default(false) @map("high_added_low")
  interactionScore Float     @default(0.5) @map("interaction_score") @db.Real
  lastHangoutAt    DateTime? @map("last_hangout_at") @db.Timestamptz(6)

  userLow  User @relation("FriendshipLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh User @relation("FriendshipHigh", fields: [userHighId], references: [id], onDelete: Cascade)

  @@unique([userLowId, userHighId])
  @@map("friendships")
}

model ExplicitGroup {
  id        String @id @default(uuid()) @db.Uuid
  name      String
  createdBy String @map("created_by") @db.Uuid

  creator User          @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  members GroupMember[]
  events  Event[]

  @@map("explicit_groups")
}

model GroupMember {
  groupId String @map("group_id") @db.Uuid
  userId  String @map("user_id") @db.Uuid
  role    String @default("member")

  group ExplicitGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@map("group_members")
}

model UserFavorite {
  id            String  @id @default(uuid()) @db.Uuid
  userId        String  @map("user_id") @db.Uuid
  category      String
  venueName     String? @map("venue_name")
  googlePlaceId String? @map("google_place_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_favorites")
}

/// Partial unique index on group_key WHERE status IN ('voting','confirmed')
/// lives in migration SQL (Prisma can't express it).
model Event {
  id            String      @id @default(uuid()) @db.Uuid
  groupKey      String      @map("group_key") // sorted member ids joined
  sourceGroupId String?     @map("source_group_id") @db.Uuid
  status        EventStatus @default(voting)
  startsAt      DateTime    @map("starts_at") @db.Timestamptz(6)
  endsAt        DateTime    @map("ends_at") @db.Timestamptz(6)
  vibeTag       VibeTag     @map("vibe_tag")
  timezone      String
  venuePlaceId  String?     @map("venue_place_id")
  venueName     String?     @map("venue_name")
  venueLat      Float?      @map("venue_lat")
  venueLng      Float?      @map("venue_lng")
  venueStatus   VenueStatus @default(open) @map("venue_status")
  backupVenues  Json        @default("[]") @map("backup_venues") // EventOption[] snapshots
  voteClosesAt  DateTime    @map("vote_closes_at") @db.Timestamptz(6)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt    DateTime?   @map("resolved_at") @db.Timestamptz(6)

  sourceGroup  ExplicitGroup?     @relation(fields: [sourceGroupId], references: [id], onDelete: SetNull)
  participants EventParticipant[]
  options      EventOption[]
  votes        Vote[]
  expenses     Expense[]

  @@index([groupKey])
  @@index([status, voteClosesAt])
  @@map("events")
}

model EventParticipant {
  eventId    String     @map("event_id") @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  voteStatus VoteStatus @default(invited) @map("vote_status")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@map("event_participants")
}

model EventOption {
  id              String  @id @default(uuid()) @db.Uuid
  eventId         String  @map("event_id") @db.Uuid
  rank            Int
  placeId         String  @map("place_id")
  name            String
  lat             Float
  lng             Float
  primaryType     String? @map("primary_type")
  priceLevel      Int?    @map("price_level")
  rating          Float?  @db.Real
  userRatingCount Int?    @map("user_rating_count")
  travelMinutes   Json    @map("travel_minutes") // { "<user_id>": 12, ... }
  maxTravelMin    Int     @map("max_travel_min")
  routeScore      Float   @map("route_score") @db.Real
  factsLine       String  @map("facts_line")
  aiBlurb         String? @map("ai_blurb")

  event Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  votes Vote[]

  @@unique([eventId, rank])
  @@map("event_options")
}

/// Never exposed per-user via API or socket.
model Vote {
  eventId  String   @map("event_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  optionId String   @map("option_id") @db.Uuid
  castAt   DateTime @default(now()) @map("cast_at") @db.Timestamptz(6)

  event  Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  option EventOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@map("votes")
}

// ---------- stretch ----------
model Expense {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  paidBy      String   @map("paid_by") @db.Uuid
  totalCents  Int      @map("total_cents")
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  event  Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  payer  User           @relation(fields: [paidBy], references: [id], onDelete: Cascade)
  splits ExpenseSplit[]

  @@map("expenses")
}

model ExpenseSplit {
  id              String  @id @default(uuid()) @db.Uuid
  expenseId       String  @map("expense_id") @db.Uuid
  userId          String  @map("user_id") @db.Uuid
  amountOwedCents Int     @map("amount_owed_cents")
  settled         Boolean @default(false)

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("expense_splits")
}
