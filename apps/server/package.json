{
  "name": "@web/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "prisma db push --skip-generate && tsx scripts/backfill.ts && tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:smoke": "tsx scripts/db-smoke.ts",
    "db:backfill": "tsx scripts/backfill.ts",
    "db:seed": "tsx scripts/seed.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "decision-data": "tsx scripts/decision-data.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@web/contract": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "socket.io": "^4.8.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.4",
    "@types/node-cron": "^3.0.11",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
