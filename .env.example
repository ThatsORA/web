# Server — copy to apps/server/.env (never commit the real file)
DATABASE_URL=mongodb+srv://USER:PASS@cluster0.xxxx.mongodb.net/web?retryWrites=true&w=majority   # MongoDB Atlas, shared M0 cluster
JWT_SECRET=change-me
INTERNAL_SECRET=change-me
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/calendar/google/callback
GOOGLE_TOKEN_ENC_KEY=00000000000000000000000000000000 # 32 bytes
GOOGLE_MAPS_API_KEY=        # Places API (New) + Routes API, restricted key
GEMINI_API_KEY=
JEV_API_KEY=           # Jev (api.typesafe.ai), fallback decision model
LAYA_URL=                   # self-hosted laya-serve base URL; empty = Jev only
LAYA_API_KEY=

VOTE_TIMEOUT_SEC=43200      # demo: 90
COOLDOWN_HOURS=48           # demo: 0
MATCH_HORIZON_DAYS=7
MIN_LEAD_HOURS=2
BUSY_PADDING_MIN=15
GEMINI_TIMEOUT_MS=8000
DECISION_TIMEOUT_MS=8000
REPORT_CLOSED_WINDOW_HOURS=24   # demo: 168
DEMO_MODE=false             # true replays apps/server/fixtures/
EMAIL_API_KEY=              # Resend (resend.com); required when verification is enabled
EMAIL_FROM="Web <verify@YOUR_VERIFIED_DOMAIN>" # sender allowed by your Resend account
EMAIL_VERIFICATION_REQUIRED=true   # demo: false (nobody reads email on stage)

# Mobile — apps/mobile/.env
EXPO_PUBLIC_API_URL=http://localhost:3000
